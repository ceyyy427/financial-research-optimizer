{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forecast_contract.schema.json",
  "title": "Forecast hierarchy and validity contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "forecast_types", "metrics", "validity_conditions", "known_failure_modes"],
  "properties": {
    "target": {"type": "string"},
    "forecast_types": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["point", "interval", "quantile", "probability", "distribution", "volatility"]}},
    "metrics": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "validity_conditions": {"type": "array", "items": {"type": "string"}},
    "known_failure_modes": {"type": "array", "items": {"type": "string"}},
    "ood_status": {"type": "string", "enum": ["in_distribution", "warning", "out_of_distribution", "not_checked"]},
    "model_age": {"type": ["string", "number", "null"]},
    "last_retrained_at": {"type": ["string", "null"]}
  }
}
