{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution_contract.schema.json",
  "title": "Backtest execution convention",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal_time", "decision_time", "execution_time", "execution_price", "market_calendar", "latency_bars", "slippage_bps", "partial_fill_rule"],
  "properties": {
    "signal_time": {"type": "string"},
    "decision_time": {"type": "string"},
    "execution_time": {"type": "string"},
    "execution_price": {"type": "string"},
    "market_calendar": {"type": "string", "minLength": 1},
    "latency_bars": {"type": "integer", "minimum": 0},
    "slippage_bps": {"type": "number", "minimum": 0},
    "partial_fill_rule": {"type": "string", "minLength": 1},
    "cash_interest": {"type": "string"},
    "dividend_policy": {"type": "string"}
  }
}
