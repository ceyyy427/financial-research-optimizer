{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data_quality.schema.json",
  "title": "Dataset grain and quality report",
  "type": "object",
  "additionalProperties": true,
  "required": ["lineage_refs"],
  "properties": {
    "lineage_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metric_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "value", "calculation_id", "input_hash", "code_version", "formula", "source_ids"],
        "properties": {
          "metric_id": {"type": "string"}, "value": {}, "calculation_id": {"type": "string"},
          "input_hash": {"type": "string"}, "code_version": {"type": "string"},
          "formula": {"type": "string"}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "quality": {
      "type": "object",
      "required": ["quality_score", "freshness_score", "completeness_score", "point_in_time_score", "source_reliability_score", "decision"],
      "properties": {
        "quality_score": {"type": "number", "minimum": 0, "maximum": 1},
        "freshness_score": {"type": "number", "minimum": 0, "maximum": 1},
        "completeness_score": {"type": "number", "minimum": 0, "maximum": 1},
        "point_in_time_score": {"type": "number", "minimum": 0, "maximum": 1},
        "source_reliability_score": {"type": "number", "minimum": 0, "maximum": 1},
        "decision": {"type": "string", "enum": ["usable", "usable_with_warning", "degraded", "blocked"]}
      }
    },
    "grain": {
      "type": "object",
      "required": ["inferred_grain", "duplicate_grain_rows", "grain_pass"],
      "properties": {
        "inferred_grain": {"type": "array", "items": {"type": "string"}},
        "duplicate_grain_rows": {"type": "integer", "minimum": 0},
        "mixed_vintage_groups": {"type": "integer", "minimum": 0},
        "mixed_unit_groups": {"type": "integer", "minimum": 0},
        "grain_pass": {"type": "boolean"}
      }
    },
    "schema_drift": {"$ref": "schema_drift.schema.json"}
  }
}
