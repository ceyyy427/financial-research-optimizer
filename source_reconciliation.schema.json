{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_reconciliation.schema.json",
  "title": "Financial source reconciliation result",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "status": {"type": "string", "enum": ["match", "minor_difference", "missing_source", "material_conflict", "timestamp_conflict", "adjustment_mismatch", "unresolved"]},
    "records": {"type": "integer", "minimum": 0},
    "summary": {
      "type": "object",
      "required": ["stop_dependency_analysis"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "stop_dependency_analysis": {"type": "boolean"},
        "hard_statuses": {"type": "array", "items": {"type": "string"}},
        "source_priority": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tolerance": {
      "type": "object",
      "properties": {
        "price_rel": {"type": "number", "minimum": 0},
        "volume_rel": {"type": "number", "minimum": 0},
        "price_abs": {"type": "number", "minimum": 0},
        "volume_abs": {"type": "number", "minimum": 0}
      }
    },
    "source_priority": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stop_dependency_analysis": {"type": "boolean"},
    "records_detail": {"type": "array"},
    "records_list": {"type": "array"}
  }
}
