{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema_drift.schema.json",
  "title": "Dataset schema drift report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_drift_detected", "new_fields", "missing_fields", "changed_types", "changed_units"],
  "properties": {
    "schema_drift_detected": {"type": "boolean"},
    "new_fields": {"type": "array", "items": {"type": "string"}},
    "missing_fields": {"type": "array", "items": {"type": "string"}},
    "changed_types": {"type": "array", "items": {"type": "string"}},
    "changed_units": {"type": "array", "items": {"type": "string"}}
  }
}
