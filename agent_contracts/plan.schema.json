{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Research plan DAG",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "goal", "mode", "output_level", "nodes", "immutable_contract"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "mode": {"type": "string"},
    "output_level": {"type": "string"},
    "immutable_contract": {"type": "object"},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "tool", "depends_on", "success_condition", "failure_condition", "max_retries", "timeout_seconds", "budget", "allow_degraded", "artifacts"],
        "properties": {
          "id": {"type": "string"},
          "tool": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "success_condition": {"type": "string"},
          "failure_condition": {"type": "string"},
          "max_retries": {"type": "integer", "minimum": 0},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "budget": {"type": "object"},
          "allow_degraded": {"type": "boolean"},
          "artifacts": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
