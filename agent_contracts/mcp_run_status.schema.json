{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp_run_status.schema.json",
  "title": "MCP research run status",
  "type": "object",
  "required": ["run_id", "status", "stage", "progress", "completed_nodes", "blocked_nodes", "fallback_used"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"},
    "status": {"type": "string", "enum": ["accepted", "running", "waiting_authorization", "waiting_input", "completed", "degraded", "fallback", "blocked", "failed", "cancelled", "planning_only"]},
    "stage": {"type": "string"},
    "progress": {"type": "object", "required": ["completed", "total"], "properties": {"completed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "completed_nodes": {"type": "array", "items": {"type": "string"}},
    "blocked_nodes": {"type": "array", "items": {"type": "string"}},
    "fallback_used": {"type": "boolean"},
    "plan_id": {"type": ["string", "null"]},
    "completion_level": {"type": ["string", "null"]},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "missing_capabilities": {"type": "array", "items": {"type": "string"}},
    "worker_id": {"type": ["string", "null"]},
    "lease_until": {"type": ["string", "null"], "format": "date-time"},
    "heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
    "attempt": {"type": "integer", "minimum": 0},
    "owner_id": {"type": ["string", "null"]},
    "tenant_id": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
