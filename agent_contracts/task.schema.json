{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Research agent task contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "mode", "output_level", "constraints"],
  "properties": {
    "task": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["data_audit", "descriptive_analysis", "forecasting", "backtest", "portfolio_research"]},
    "output_level": {"type": "string", "enum": ["minimal", "standard", "research_grade", "portfolio_grade"]},
    "universe": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "target": {"type": "string"},
    "horizon": {"type": ["string", "integer"]},
    "constraints": {"type": "object"},
    "authorized_context": {"type": "boolean"},
    "allow_browser": {"type": "boolean"}
  }
}
