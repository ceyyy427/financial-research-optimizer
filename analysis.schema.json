{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis.schema.json",
  "title": "Financial Research Optimizer analysis output",
  "type": "object",
  "additionalProperties": true,
  "required": ["mode", "meta", "summary", "modules", "decision_rows"],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "reproducibility_status": {"type": "string", "enum": ["complete", "partial", "failed"]},
    "mode": {"type": "string", "enum": ["data_audit", "descriptive_analysis", "forecasting", "backtest", "portfolio_research"]},
    "meta": {"type": "object"},
    "summary": {"type": "object"},
    "forecast": {"type": "object"},
    "charts": {"type": "array", "minItems": 1},
    "modules": {"type": "array", "minItems": 1},
    "model_cards": {"type": "array", "minItems": 1},
    "selection_protocol": {"$ref": "model_selection.schema.json"},
    "backtest_overfitting": {"$ref": "backtest_overfitting.schema.json"},
    "source_reconciliation": {"$ref": "source_reconciliation.schema.json"},
    "feature_label_audit": {"$ref": "feature_label_audit.schema.json"},
    "portfolio_robustness": {"$ref": "portfolio_output.schema.json"},
    "decision_rows": {"type": "array", "minItems": 1}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "data_audit"}}, "required": ["mode"]}, "then": {"required": ["sources"]}},
    {"if": {"properties": {"mode": {"enum": ["descriptive_analysis", "forecasting", "backtest", "portfolio_research"]}}, "required": ["mode"]}, "then": {"required": ["charts"]}},
    {"if": {"properties": {"mode": {"enum": ["forecasting", "backtest", "portfolio_research"]}}, "required": ["mode"]}, "then": {"required": ["forecast", "model_cards", "selection_protocol"]}},
    {"if": {"properties": {"mode": {"enum": ["backtest", "portfolio_research"]}}, "required": ["mode"]}, "then": {"required": ["backtest_overfitting"]}},
    {"if": {"properties": {"mode": {"const": "portfolio_research"}}, "required": ["mode"]}, "then": {"required": ["portfolio_robustness"]}}
  ]
}
