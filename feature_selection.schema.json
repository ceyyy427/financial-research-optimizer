{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature_selection.schema.json",
  "title": "High-dimensional factor selection output",
  "type": "object",
  "additionalProperties": true,
  "required": ["method", "selected_features", "scores", "class_counts", "sample_size", "feature_count", "selection_scope"],
  "properties": {
    "method": {"type": "string"},
    "selected_features": {"type": "array", "items": {"type": "string"}},
    "scores": {"type": "object", "additionalProperties": {"type": "number"}},
    "class_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "sample_size": {"type": "integer", "minimum": 1},
    "feature_count": {"type": "integer", "minimum": 1},
    "selection_scope": {"type": "string"},
    "lineage_refs": {"type": "array", "items": {"type": "string"}}
  }
}
