{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui.schema.json",
  "title": "Offline research dashboard UI configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {"type": "string", "enum": ["system", "light", "dark"]},
    "density": {"type": "string", "enum": ["comfortable", "compact"]},
    "default_section": {"type": "string"},
    "show_provenance": {"type": "boolean"},
    "show_raw_tables": {"type": "boolean"},
    "chart_interaction": {"type": "string", "enum": ["enabled", "disabled"]}
  }
}
