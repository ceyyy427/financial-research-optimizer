{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning_cards.schema.json",
  "title": "Prediction learning cards",
  "type": "object",
  "required": ["schema_version", "card_count", "cards"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "card_count": {"type": "integer", "minimum": 0},
    "generated_from": {"type": "array", "items": {"type": "string"}},
    "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}}
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": ["card_id", "concept", "category", "formula_id", "formula", "variables", "derivation_steps", "numeric_example", "applicability", "failure_boundaries", "self_test", "evidence_refs", "lineage_refs", "source_ids", "input_hash", "status"],
      "properties": {
        "card_id": {"type": "string"},
        "concept": {"type": "string"},
        "category": {"type": "string", "enum": ["model", "risk", "portfolio", "data_quality", "uncertainty", "scenario", "evaluation", "causality"]},
        "formula_id": {"type": ["string", "null"]},
        "formula": {"type": "object"},
        "variables": {"type": "object"},
        "derivation_steps": {"type": "array", "items": {"type": "string"}},
        "numeric_example": {"type": "object"},
        "applicability": {"type": "array", "items": {"type": "string"}},
        "failure_boundaries": {"type": "array", "items": {"type": "string"}},
        "self_test": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "lineage_refs": {"type": "array", "items": {"type": "string"}},
        "knowledge_refs": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "input_hash": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["available", "not_available"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
