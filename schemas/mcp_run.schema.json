{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp_run.schema.json",
  "title": "MCP research run response",
  "description": "Stable response envelope for phase-one MCP tools.",
  "type": "object",
  "required": ["status"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_.-]{2,127}$"},
    "status": {"type": "string", "enum": ["accepted", "running", "completed", "blocked", "failed", "cancelled", "planning_only"]},
    "plan_id": {"type": ["string", "null"]},
    "artifact_base_uri": {"type": "string", "pattern": "^research://runs/run_"},
    "reason_code": {"type": "string"},
    "message": {"type": "string"},
    "user_action_required": {"type": "boolean"},
    "stage": {"type": "string"},
    "progress": {
      "type": "object",
      "required": ["completed", "total"],
      "properties": {"completed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "completed_nodes": {"type": "array", "items": {"type": "string"}},
    "blocked_nodes": {"type": "array", "items": {"type": "string"}},
    "fallback_used": {"type": "boolean"},
    "completion_level": {"type": ["string", "null"]},
    "artifact_uri": {"type": "string", "pattern": "^research://runs/run_"},
    "mime_type": {"type": "string"},
    "path": {"type": "string"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "registered": {"type": "boolean"},
    "content": {"type": "string"}
  },
  "additionalProperties": true
}
