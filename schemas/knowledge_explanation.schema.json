{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge_explanation.schema.json",
  "title": "Explainable research claim",
  "type": "object",
  "required": ["claim_id", "title", "claim_level", "claim_type", "statement", "formula", "evidence_refs", "calculation_refs", "confidence", "caveats", "next_check"],
  "properties": {
    "claim_id": {"type": "string"},
    "title": {"type": "string"},
    "claim_level": {"type": "string", "enum": ["observed", "predictive", "decision"]},
    "claim_type": {"type": "string", "enum": ["data_observation", "model_mechanism", "model_contribution", "risk_explanation", "uncertainty_explanation", "scenario_explanation", "causal_hypothesis", "failure_boundary"]},
    "statement": {"type": "string"},
    "formula_id": {"type": "string"},
    "formula": {"type": "object", "required": ["formula_id", "tex", "alt_text"], "properties": {"formula_id": {"type": "string"}, "tex": {"type": "string"}, "alt_text": {"type": "string"}, "variables": {"type": "object"}}, "additionalProperties": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "calculation_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "string"},
    "caveats": {"type": "array", "items": {"type": "string"}},
    "next_check": {"type": "string"}
  },
  "additionalProperties": true
}
