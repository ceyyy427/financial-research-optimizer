{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_request.schema.json",
  "title": "Financial source adapter request",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "dataset"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "dataset": {"type": "string", "minLength": 1},
    "instrument": {"type": ["string", "null"]},
    "start": {"type": ["string", "null"]},
    "end": {"type": ["string", "null"]},
    "as_of": {"type": ["string", "null"]},
    "adjustment": {"type": ["string", "null"]},
    "authorization_ref": {"type": ["string", "null"]},
    "params": {"type": "object"},
    "requested_url": {"type": ["string", "null"], "format": "uri"}
  }
}
