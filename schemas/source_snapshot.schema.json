{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_snapshot.schema.json",
  "title": "Source adapter raw snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "source_id", "request_url", "request_params", "retrieved_at", "response_status", "content_type", "response_hash", "snapshot_hash", "raw_file", "parser_version", "access_method", "source_authority", "authorization_status", "point_in_time_status", "revision_status"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "request_url": {"type": "string", "format": "uri"},
    "request_params": {"type": "object"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "response_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "content_type": {"type": "string", "minLength": 1},
    "response_hash": {"type": "string", "minLength": 8},
    "snapshot_hash": {"type": "string", "minLength": 8},
    "raw_file": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "provider_version": {"type": "string"},
    "access_method": {"type": "string"},
    "source_authority": {"type": "string"},
    "authorization_status": {"type": "string", "enum": ["not_required", "authorized", "unauthorized", "expired", "unknown"]},
    "point_in_time_status": {"type": "string", "enum": ["pass", "fail", "not_available", "unknown"]},
    "revision_status": {"type": "string", "enum": ["vintage_aware", "release_aware", "latest_only", "unknown"]},
    "observation_date": {"type": ["string", "null"]},
    "release_date": {"type": ["string", "null"]},
    "availability_date": {"type": ["string", "null"]},
    "vintage_date": {"type": ["string", "null"]},
    "license": {"type": "string"},
    "cache_expiry": {"type": ["string", "null"]},
    "fallback_used": {"type": "boolean"}
  }
}
