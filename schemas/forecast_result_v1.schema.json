{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forecast_result_v1.schema.json",
  "title": "ForecastResult v1",
  "type": "object",
  "required": ["schema_version", "status", "selected_model", "forecast_origin", "horizon"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"type": "string", "enum": ["completed", "degraded", "blocked", "failed"]},
    "selected_model": {"type": ["string", "null"]},
    "selection_metric": {"type": ["string", "null"]},
    "evaluation_window": {"type": ["string", "object", "null"]},
    "forecast_origin": {"type": "string"},
    "horizon": {"type": ["string", "integer", "number"]},
    "interval_method": {"type": ["string", "null"]},
    "calibration_status": {"type": ["string", "null"]},
    "ood_status": {"type": ["string", "null"]},
    "forecast": {},
    "provenance": {"type": ["object", "array"]},
    "artifacts": {"type": "array"}
  },
  "additionalProperties": true
}
