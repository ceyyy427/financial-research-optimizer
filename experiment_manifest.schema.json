{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ceyyy427/financial-research-optimizer/blob/main/experiment_manifest.schema.json",
  "title": "Financial Research Optimizer experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "config_fingerprint", "data_snapshot_hash", "code_version", "environment", "random_seeds", "model_parameters", "feature_version", "train_window", "evaluation_window", "outputs", "reproducibility_status"],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["data_audit", "descriptive_analysis", "forecasting", "backtest", "portfolio_research"]},
    "output_level": {"type": "string", "enum": ["minimal", "standard", "research_grade", "portfolio_grade"]},
    "config_fingerprint": {"type": "string", "minLength": 8},
    "data_snapshot_hash": {"type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": {"algorithm": {"type": "string"}, "value": {"type": "string", "minLength": 16}, "path": {"type": "string"}}},
    "code_version": {"type": "object", "additionalProperties": false, "required": ["commit", "repository"], "properties": {"commit": {"type": "string", "minLength": 7}, "repository": {"type": "string"}, "dirty": {"type": "boolean"}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["python", "platform"], "properties": {"python": {"type": "string"}, "platform": {"type": "string"}, "packages_lock_hash": {"type": "string"}, "java": {"type": "string"}}},
    "random_seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "model_parameters": {"type": "object"},
    "feature_version": {"type": "string", "minLength": 1},
    "train_window": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "rows": {"type": "integer", "minimum": 0}}},
    "evaluation_window": {"type": "object", "additionalProperties": false, "required": ["start", "end", "method"], "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "method": {"type": "string"}, "rows": {"type": "integer", "minimum": 0}}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "minLength": 16}, "kind": {"type": "string"}}}},
    "source_reconciliation": {"type": "object"},
    "reproducibility_status": {"type": "string", "enum": ["complete", "partial", "failed"]}
  }
}
