{
  "source_id": "alfred",
  "name": "ALFRED",
  "region": "global",
  "authority": "federal_reserve",
  "priority": 105,
  "kind": "official_api",
  "asset_classes": ["macro", "rates", "fx"],
  "data_types": ["time_series", "releases", "vintages"],
  "access_methods": ["api", "cached_snapshot"],
  "primary_method": "api",
  "fallback_methods": ["cached_snapshot"],
  "point_in_time": true,
  "revision_aware": true,
  "authentication": {"required": true, "secret_env": "FRED_API_KEY", "status_required": true},
  "access_policy": "public",
  "browser_scraping": false,
  "roles": ["primary"],
  "parser": "fred_json_realtime_period",
  "normalizer": "macro_timeseries_v1",
  "quality_checks": ["timestamp_order", "vintage_date", "release_date", "missingness", "revision_check"],
  "required_fields": ["observation_date", "release_date", "availability_date", "vintage_date", "value", "unit", "frequency"],
  "base_urls": ["https://api.stlouisfed.org/fred/"]
}
