{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_config.schema.json",
  "title": "Financial Research Optimizer configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "universe", "target", "horizon", "frequency", "cutoff", "output_level", "costs", "constraints", "risk_measure", "confidence_level", "evaluation", "feature_label_contract", "models", "output"],
  "properties": {
    "mode": {"type": "string", "enum": ["data_audit", "descriptive_analysis", "forecasting", "backtest", "portfolio_research"]},
    "universe": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "target": {"type": "string", "enum": ["return", "excess_return", "direction", "price", "volatility", "quantile", "spread", "option_value"]},
    "horizon": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[1-9][0-9]*d$"}]},
    "frequency": {"type": "string", "enum": ["daily", "weekly", "monthly", "intraday"]},
    "cutoff": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "output_level": {"type": "string", "enum": ["minimal", "standard", "research_grade", "portfolio_grade"]},
    "costs": {
      "type": "object", "additionalProperties": false, "required": ["transaction_cost_bps"],
      "properties": {
        "transaction_cost_bps": {"type": "number", "minimum": 0},
        "slippage_bps": {"type": "number", "minimum": 0},
        "borrow_cost_bps": {"type": "number", "minimum": 0}
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false, "required": ["max_turnover", "max_drawdown"],
      "properties": {
        "max_turnover": {"type": "number", "minimum": 0},
        "max_drawdown": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_leverage": {"type": "number", "exclusiveMinimum": 0},
        "long_only": {"type": "boolean"},
        "max_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_cash": {"type": "number", "minimum": 0, "maximum": 1},
        "max_spread_bps": {"type": "number", "minimum": 0},
        "min_adv_multiple": {"type": "number", "minimum": 0},
        "market_impact_bps": {"type": "number", "minimum": 0},
        "financing_cost_bps": {"type": "number", "minimum": 0},
        "borrow_cost_bps": {"type": "number", "minimum": 0},
        "min_trade_unit": {"type": "number", "minimum": 0}
      }
    },
    "risk_measure": {"type": "string", "enum": ["volatility", "var", "cvar", "drawdown", "utility"]},
    "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "train_period", "validation_period", "test_period"],
      "properties": {
        "method": {"type": "string", "enum": ["expanding_window", "rolling_window", "blocked_time_series_cv"]},
        "train_period": {"type": "integer", "minimum": 1},
        "validation_period": {"type": "integer", "minimum": 0},
        "test_period": {"type": "integer", "minimum": 1},
        "step_size": {"type": "integer", "minimum": 1},
        "purge_gap": {"type": "integer", "minimum": 0},
        "embargo_period": {"type": "integer", "minimum": 0},
        "n_splits": {"type": "integer", "minimum": 2}
      }
    },
    "models": {
      "type": "object", "additionalProperties": false, "required": ["baselines", "challengers", "selection"],
      "properties": {
        "baselines": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "challengers": {"type": "array", "items": {"type": "string"}},
        "selection": {
          "type": "object", "additionalProperties": false, "required": ["primary_metric", "calibration_metric", "economic_metric", "stability_metric", "criteria"],
          "properties": {
            "primary_metric": {"type": "string"},
            "calibration_metric": {"type": "string"},
            "economic_metric": {"type": "string"},
            "stability_metric": {"type": "string"},
            "regime_slices": {"type": "array", "items": {"type": "string"}},
            "seed_count": {"type": "integer", "minimum": 1},
            "window_sensitivity_metric": {"type": "string"},
            "feature_ablation_required": {"type": "boolean"},
            "benchmark_required": {"type": "boolean"},
            "max_candidates": {"type": "integer", "minimum": 1},
            "criteria": {
              "type": "object", "additionalProperties": false,
              "required": ["statistical_validity", "predictive_performance", "economic_effectiveness", "regime_stability", "seed_window_sensitivity"],
              "properties": {
                "statistical_validity": {"type": "number", "minimum": 0, "maximum": 1},
                "predictive_performance": {"type": "number", "minimum": 0, "maximum": 1},
                "economic_effectiveness": {"type": "number", "minimum": 0, "maximum": 1},
                "regime_stability": {"type": "number", "minimum": 0, "maximum": 1},
                "seed_window_sensitivity": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    },
    "feature_label_contract": {"$ref": "feature_label_contract.schema.json"},
    "preflight": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "require_manifest": {"type": "boolean"},
        "require_dataset": {"type": "boolean"},
        "require_reconciliation": {"type": "boolean"}
      }
    },
    "online": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "provider_registry": {"type": "array", "items": {"type": "string"}},
        "cache_dir": {"type": "string", "minLength": 1},
        "snapshot_dir": {"type": "string", "minLength": 1},
        "max_staleness_minutes": {"type": "integer", "minimum": 0},
        "allow_stale_cache": {"type": "boolean"},
        "require_raw_response": {"type": "boolean"},
        "revision_policy": {"type": "string", "enum": ["point_in_time", "vintage_aware", "filing_date_aware", "latest_only"]}
      }
    },
    "refresh_policy": {"$ref": "refresh_policy.schema.json"},
    "output": {
      "type": "object", "additionalProperties": false, "required": ["artifact_dir", "analysis_json", "html_file", "decision_table_csv", "decision_table_md"],
      "properties": {
        "artifact_dir": {"type": "string", "minLength": 1},
        "analysis_json": {"type": "string", "minLength": 1},
        "html_file": {"type": "string", "minLength": 1},
        "decision_table_csv": {"type": "string", "minLength": 1},
        "decision_table_md": {"type": "string", "minLength": 1}
      }
    },
    "source_policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "price_abs_tolerance": {"type": "number", "minimum": 0},
        "price_rel_tolerance": {"type": "number", "minimum": 0},
        "volume_abs_tolerance": {"type": "number", "minimum": 0},
        "volume_rel_tolerance": {"type": "number", "minimum": 0},
        "priority": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
