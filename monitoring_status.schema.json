{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "monitoring_status.schema.json",
  "title": "Online model monitoring status",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_status", "drift_status", "retrain_trigger", "fallback", "checks"],
  "properties": {
    "model_id": {"type": "string"},
    "model_status": {"type": "string", "enum": ["active", "warning", "retrain_required", "fallback"]},
    "last_retrained_at": {"type": "string"},
    "last_validated_at": {"type": "string"},
    "drift_status": {"type": "string", "enum": ["ok", "warning", "failed"]},
    "retrain_trigger": {"type": "string"},
    "fallback": {"type": "string"},
    "monitoring_event_id": {"type": "string"},
    "trigger_threshold": {"type": "object"},
    "severity": {"type": "string", "enum": ["info", "warning", "retrain_requested", "research_required", "model_disabled"]},
    "owner": {"type": "string"},
    "recommended_action": {"type": "string"},
    "cooldown_period": {"type": ["string", "number"]},
    "last_triggered_at": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {"type": "object"}},
    "data_status": {"type": "string", "enum": ["ready", "stale", "degraded", "blocked", "fallback"]}
  }
}
