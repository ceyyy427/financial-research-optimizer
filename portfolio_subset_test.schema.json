{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio_subset_test.schema.json",
  "title": "Effective asset subset test output",
  "type": "object",
  "additionalProperties": true,
  "required": ["null_hypothesis", "test_statistic", "p_value", "bootstrap_interval", "spanning_status", "subset_status", "power_diagnostic", "window_stability"],
  "properties": {
    "null_hypothesis": {"type": "string"},
    "test_statistic": {"type": "number"},
    "p_value": {"type": "number", "minimum": 0, "maximum": 1},
    "bootstrap_interval": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "spanning_status": {"type": "string"},
    "subset_status": {"type": "string"},
    "power_diagnostic": {"type": "object"},
    "window_stability": {"type": "object"},
    "bootstrap": {"type": "object"},
    "status": {"type": "string"},
    "lineage_refs": {"type": "array", "items": {"type": "string"}}
  }
}
