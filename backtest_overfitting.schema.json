{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ceyyy427/financial-research-optimizer/blob/main/backtest_overfitting.schema.json",
  "title": "Applicable backtest-overfitting diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_count", "trial_count", "methods", "gate_status"],
  "properties": {
    "candidate_count": {"type": "integer", "minimum": 1},
    "trial_count": {"type": "integer", "minimum": 1},
    "gate_status": {"type": "string", "enum": ["not_triggered", "pass", "warning", "failed"]},
    "note": {"type": "string"},
    "lineage_refs": {"type": "array", "items": {"type": "string"}},
    "methods": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["method", "applicable", "reason", "input_requirements", "blocking_level", "status", "interpretation"],
        "properties": {
          "method": {"type": "string", "enum": ["DM", "WRC", "SPA", "DSR", "PBO"]},
          "applicable": {"type": "boolean"},
          "reason": {"type": "string"},
          "applicability_reason": {"type": "string"},
          "input_requirements": {"type": "array", "items": {"type": "string"}},
          "blocking_level": {"type": "string", "enum": ["none", "warning", "selection_blocker"]},
          "status": {"type": "string", "enum": ["not_applicable", "pending", "pass", "warning", "failed"]},
          "statistic": {},
          "p_value": {},
          "interpretation": {"type": "string"},
          "minimum_observations": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
